#!/bin/sh

#
# Gradle start up script for POSIX generated by Gradle.
#

# We don't actually include the full Gradle wrapper here.
# Run `gradle wrapper` in the android/ directory to generate it,
# or download the Gradle wrapper JAR manually.
#
# For now, the build process is:
#   1. cd android && ./build_rust.sh    # cross-compile Rust -> .so
#   2. cd android && ./gradlew assembleDebug  # build APK

echo "Run: gradle wrapper  to generate the full Gradle wrapper"